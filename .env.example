# Copy to .env.local and fill in. Everything here is optional: a missing key
# lowers what the system can claim rather than stopping it from running.
#
# One free key runs the whole thing. Set the CHEAP_* trio and the prose tier
# reuses it automatically; only set PROSE_* if you want a better writer for the
# single explanation call per run.

# ---------------------------------------------------------------------------
# Cheap tier - interview, extraction, classification (~90% of tokens)
# ---------------------------------------------------------------------------
# Any OpenAI-compatible /chat/completions endpoint. Gemini, Groq, OpenRouter,
# DeepSeek and a local Ollama all expose one, so switching provider is three
# variables rather than a code change.
#
# Gemini (free tier, Google AI Studio - https://aistudio.google.com/apikey):
#   CHEAP_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#
# Groq (free tier - https://console.groq.com/keys):
#   CHEAP_BASE_URL=https://api.groq.com/openai/v1
#
# Local Ollama (no key needed; any non-empty CHEAP_API_KEY will do):
#   CHEAP_BASE_URL=http://localhost:11434/v1
#
# CHEAP_MODEL is deliberately not defaulted. Free tiers retire model names, and
# a stale default fails confusingly at request time instead of clearly at
# startup. Copy the exact current id from your provider's model list.
CHEAP_API_KEY=
CHEAP_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CHEAP_MODEL=

# ---------------------------------------------------------------------------
# Prose tier - one call per run, the only text a person reads
# ---------------------------------------------------------------------------
# Leave blank to reuse the cheap tier. Free models write flatter explanations,
# but the citation pass deletes any sentence without a resolvable source, so the
# downside is dull prose rather than invented prose.
PROSE_API_KEY=
PROSE_BASE_URL=
PROSE_MODEL=

# Optional alternative for the prose tier only. If set and PROSE_* is blank,
# the verdict explanation uses Claude Haiku 4.5. This is a paid API.
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Sources
# ---------------------------------------------------------------------------
# Both v1 adapters work without any key. A GitHub token only raises the rate
# limit from roughly 10 searches a minute to 30.
# GITHUB_TOKEN=

# Wall-clock budget for the gather stage. Keep it well under the 60s cap on
# Vercel's Hobby tier - adapters that miss it are recorded as timed_out and
# lower confidence rather than failing the run.
# GATHER_DEADLINE_MS=40000
