{
  "name": "reality-check",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty && pnpm --filter @rc/web typecheck",
    "evals": "vitest run packages/rubric/src/evals",
    "validate": "tsx packages/cli/src/index.ts validate",
    "seed": "tsx packages/cli/src/index.ts seed",
    "web": "pnpm --filter @rc/web dev"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
